mp3drop : "\![sound,load,${chemin}\1\s[10]double cliques sur mon oreille gauche pour jouer la musique, et mon oreille droite pour arreter"

OnFileDrop2 : $(
	setstr mp3 "oui";
	setstr chemin ${System.Request.Reference0};
	if $[ ${mp3} == "oui" ] \1\s[10]${mp3drop};
	)
MouseDoubleClick1play : $(
	if $[ ${mp3} == "oui" ] \![sound,play,${chemin}]\0\s[6]
)
MouseDoubleClick1stop : $(
	if $[ ${mp3} == "oui" ] \![sound,stop]\0\s[0]
)
