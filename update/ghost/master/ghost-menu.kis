SakuMenuTalk : "\0\s[0]Je peux faire quelque-chose pour toi ?","\0\s[0]dis-moi !","\0\s[0]Oui ?"

song : "\0\s[3]avec plaisir, ce morceau s'intitule Proj3 1 - 07 New Sample.mp3 \1\s[10]t\'aurais pu faire un effort sur le titre... \![sound,play,1.mp3]\0\s[7]", "\0\s[3]avec plaisir, voici \'when i said i wished u well i lied I wished us a life together instead knowing it couldn\'t end up well\' \1\s[10]ca en fait des mots... \![sound,play,2.mp3]\0\s[7]", "\0\s[3]avec plaisir, voici \'ur arms are the shortest path to peace i know pls tell me if I ever abuse it\' \![sound,play,3.mp3]\0\s[7]", "\0\s[3]avec plaisir, voici WETTEST MOP CHAMPIONSHIP \![sound,play,4.mp3]\0\s[7]", "\0\s[3]avec plaisir, voici 4446 7777666 7777666777777999 333666777 339944477778444664 \1\s[10]ca en fait des chiffres...\![sound,play,5.mp3]\0\s[7]"

OnSakuraMenu : (
    $( if $[ $(Reference 0) != 1 ] $(setstr MenuDialogue ${SakuMenuTalk}\w4 ) else if $[ $( match ${MenuDialogue} "\_q" ) == -1 ] $(setstr MenuDialogue \_q${MenuDialogue}\_q ) )

    \t\*\b2${MenuDialogue}\_q\![set,autoscroll,disable]
    \n\n[half]
    \![*]\q[Dis quelque-chose !,OnAITalk]
    $( if $[ ${lastTalk} ] (\n\n[half]\![*]\q[Repete ?,OnLastTalk]) )
    \n\n[half]\![*]\q[Chante moi une chanson !,OnNeve]
    \n\n[half]
    \n\n[half]
    \![*]\q[Quitter le menu,OnQuit,0]
    \n\n

    $(setstr @interval ${talkinterval})
    $( if $[ ${@interval} == 'Never' ] $(setstr @form "") else if $[ ${@interval} > 59 ] $( setstr @interval $[ ${@interval} / 60 ]; setstr @form minutes ) else $( setstr @form seconds ) )
    $(if $[${@interval} == 1] $(setstr @form minute))

    "\f[italic,true]Parle toute les:" ${@interval} ${@form}\n\f[italic,default]
    \![*]\q[30s,OnAssignTalkRate,30] \![*]\q[1m,OnAssignTalkRate,60] \![*]\q[3m,OnAssignTalkRate,180]
    "\![*]\q[5m,OnAssignTalkRate,300] \![*]\q[10m,OnAssignTalkRate,600] \![*]\q[15m,OnAssignTalkRate,900] \![*]\q[Never,OnAssignTalkRate,Never]"
    \n\n[half]

    $(setstr @weekday $(if $[$(date %w) == 0] "Dimanche" else if $[$(date %w) == 1] "Lundi" else if $[$(date %w) == 2] "Mardi" else if $[$(date %w) == 3] "Mercredi" else if $[$(date %w) == 4] "Jeudi" else if $[$(date %w) == 5] "Vendredi" else if $[$(date %w) == 6] "Samedi"))
    $(setstr @hour $(date %H); setstr @minute $(date %M))

    \f[italic,true]${@weekday}", %day/%month, "${@hour}":"${@minute}\f[italic,default]
)



OnNeve : (
	$( setstr mp3 "oui" )
	${song}
	\1\s[10]\n\ndouble-clique sur mon oreille droite si tu veux arreter le son"
)

OnAssignTalkRate : (
    $( setstr talkinterval $(Reference 0); set @dialogue $(Reference 1) )
    "\![raise,OnSakuraMenu,1]"
)

OnQuit : $(
    if $[$(Reference 0) == 0] \![close,inputbox,__SYSTEM_ALL_INPUT__]${SakuraQuit}
    else \![close,inputbox,__SYSTEM_ALL_INPUT__]${KeroQuit}
)

SakuraQuit : "\0\s[0]ok !", "\0\s[0]Pas de soucis !"

OnLastTalk : ${lastTalk}

OnShowData : $(
    foreach @entries savedataParam $( echo "\b2"${@entries}": "; echo ${${@entries}}"\n" )
)

OnTestVariable : (
    "\1\s[10]test en cours !\n\n[half]"
)
